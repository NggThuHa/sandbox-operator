# ==============================================================================
# KUBEBUILDER LAB OPERATOR ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# ==============================================================================
# Sao chép tệp tin này thành `.env` (nếu chạy local debug/make run) 
# hoặc nạp thẳng vào configmap/environment trong Kuberentes Deployment của Operator.
# ==============================================================================

# 1. STORAGE CLASS CONFIGURATIONS
# Lớp hạ tầng lưu trữ theo hai phân nhóm mục đích mượt mà cho Lab platform
# - Local Storage (I/O cực cao, dành cho ổ đĩa Root/Hệ điều hành Sysbox container):
#   * K3s: local-path (Mặc định)
#   * EKS/GKE: gp2 / standard / gp3
DEFAULT_LOCAL_STORAGE_CLASS="local-path"

# - Network Storage (Phân tán, chịu lỗi, dùng cho ổ data mount như /var/lib/docker):
#   * K3s: longhorn / rook-ceph-block (Mặc định: longhorn)
#   * Cloud: ebs / nfs-csi / efs
DEFAULT_NETWORK_STORAGE_CLASS="longhorn"

# 2. INGRESS & ROUTING CONFIGURATIONS
# Lớp phân luồng lưu lượng truy cập từ ngoài Internet vào Terminal của Sinh viên
# Mặc định: nginx (hoặc traefik nếu cụm K3s dùng bộ traefik có sẵn)
DEFAULT_INGRESS_CLASS="nginx"

# 3. KUBERNETES RUNTIME CONFIGURATION
# Định danh runtime engine dùng để cho phép chạy container-in-container (Docker bên trong VM)
# Mặc định: sysbox-runc (trên các node đã được Ansible provision từ playbooks của chúng ta)
DEFAULT_RUNTIME_CLASS="sysbox-runc"

# 4. CONTROLLER MANAGER RUNTIME FLAGS (Dùng cho cmd/main.go)
# Binding cho trang thông tin theo dõi sức khỏe và metrics prometheus
METRICS_BIND_ADDRESS=":8080"
HEALTH_PROBE_BIND_ADDRESS=":8081"
LEADER_ELECT="true"

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Vendored dependencies are not tracked; reproducibility comes from go.sum.
# Run `go mod vendor` locally if you need an offline build.
/vendor/

# Terraform: provider binaries and local state must never be committed.
# .terraform.lock.hcl IS tracked on purpose (pins provider hashes).
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
.terraform.tfstate.lock.info

# Ansible / Molecule
*.retry
.molecule/

# Local agent tooling. Skills are pinned in skills-lock.json instead.
/.agents/
/.claude/

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Kubeconfig might contain secrets
*.kubeconfig
**/host.ini
**/k3s.yaml

# Generated distribution installer manifests
dist/
